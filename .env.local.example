# Copiá este archivo a .env.local y completá con los datos de tu proyecto
# de Supabase (Project Settings → API). Nunca commitear .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (sin / al final). Se usa para armar los links de los
# mails de Supabase (confirmación, recuperar contraseña) y los metadatos de
# vista previa (og:image, etc). Sin esto, en dev cae a http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Solo para correr los tests de integración en tu máquina (crean y borran
# usuarias de prueba). No se usa en el código de la app ni se expone al
# navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Solo para aplicar las migraciones (supabase db push). Project Settings →
# Database → Connection string → URI. Tampoco se usa en el código de la app.
DATABASE_URL=
